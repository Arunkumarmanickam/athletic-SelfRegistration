# ============================================================================
# Athlete Registration Portal — environment variables
# ============================================================================
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to version control (it is git-ignored).
# NEVER put SECRET keys (anything without the VITE_ prefix) into frontend code.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API in the Supabase dashboard)
# ---------------------------------------------------------------------------
# VITE_ prefixed variables are compiled into the browser bundle:
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Server-only variables. These are set as "Edge Function Secrets" in Supabase
# (Dashboard -> Edge Functions -> Secrets) or via `supabase secrets set`.
# They are NEVER sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# Cashfree (Merchant Dashboard -> Developers -> API Keys)
# ---------------------------------------------------------------------------
# Sandbox/test credentials are separate from live ones. The App ID for a test
# account starts with TEST and the secret key with cfsk_ma_test_.
CASHFREE_APP_ID=TESTxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CASHFREE_SECRET_KEY=cfsk_ma_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# "sandbox" (default) or "production". Keep sandbox until the client's Live
# account is connected.
CASHFREE_ENV=sandbox

# Legacy Razorpay values (no longer used by the checkout). Kept only because
# the Razorpay webhook receiver and helper module still exist.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Admin bootstrap
# ---------------------------------------------------------------------------
# A one-time shared secret required to create the FIRST administrator.
# Generate a long random value, e.g.: openssl rand -hex 32
# Set it as an Edge Function secret, use it once, then you may delete it.
BOOTSTRAP_ADMIN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ---------------------------------------------------------------------------
# Optional confirmations (email receipts)
# ---------------------------------------------------------------------------
# Email confirmations use the Resend API. Leave blank to disable emails.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=Registrations <registrations@example.com>

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
VITE_SITE_URL=http://localhost:5173

# Where payment-callback sends the browser after a successful payment. Set this
# to the Vercel domain in production and to http://localhost:5173 for local
# testing (it is a server-side Edge Function secret, not VITE_).
SITE_URL=http://localhost:5173

# Cashfree checkout is loaded from this allowed origin list.
# Comma separated origins, e.g. https://yourdomain.com,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
