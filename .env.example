# ============================================================================
# Athlete Registration Portal — environment variables
# ============================================================================
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to version control (it is git-ignored).
# NEVER put SECRET keys (anything without the VITE_ prefix) into frontend code.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API in the Supabase dashboard)
# ---------------------------------------------------------------------------
# VITE_ prefixed variables are compiled into the browser bundle:
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Server-only variables. These are set as "Edge Function Secrets" in Supabase
# (Dashboard -> Edge Functions -> Secrets) or via `supabase secrets set`.
# They are NEVER sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# Razorpay (Dashboard -> Settings -> API Keys / Webhooks)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
# Secret you configure on the Razorpay webhook (payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# ---------------------------------------------------------------------------
# Admin bootstrap
# ---------------------------------------------------------------------------
# A one-time shared secret required to create the FIRST administrator.
# Generate a long random value, e.g.: openssl rand -hex 32
# Set it as an Edge Function secret, use it once, then you may delete it.
BOOTSTRAP_ADMIN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ---------------------------------------------------------------------------
# Returning-athlete OTP (SMS delivery)
# ---------------------------------------------------------------------------
# Provider used to deliver OTP codes: "none", "twilio" or "msg91"
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID=

# DEVELOPMENT ONLY. When "true", the OTP code is returned in the API response
# so the returning-athlete flow can be tested without an SMS provider.
# It only works for requests that come from http://localhost:*.
# Leave this "false" in production.
OTP_DEV_MODE=false

# ---------------------------------------------------------------------------
# Optional confirmations (email / SMS receipts)
# ---------------------------------------------------------------------------
# Email confirmations use the Resend API. Leave blank to disable emails.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=Registrations <registrations@example.com>

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
VITE_SITE_URL=http://localhost:5173

# Razorpay checkout is loaded from this allowed origin list.
# Comma separated origins, e.g. https://yourdomain.com,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
